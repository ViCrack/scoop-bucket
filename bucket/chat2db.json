{
    "version": "0.3.7",
    "description": "An intelligent and versatile general-purpose SQL client and reporting tool for databases which integrates ChatGPT capabilities.",
    "no": "https://github.com/ViCrack/scoop-bucket/blob/16f7fc72202815c38a0d7d0e66f0a9eb4980dba5/bucket/chat2db.json",
    "homepage": "https://github.com/chat2db/Chat2DB",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/chat2db/Chat2DB/releases/download/v0.3.7/Chat2DB-Setup-0.3.7.exe",
            "hash": "f5ee97eca19b31f8cd5e085d4c53ab07552a3176a4720fa62db029107a236473"
        }
    },
    "installer": {
        "script": [
            "$nsis = Get-ChildItem \"$dir\" -Filter \"Chat2DB-Setup-*.exe\" | Select-Object -First 1",
            "if ($nsis) {",
            "    Expand-7zipArchive -Path $nsis.FullName -Removal",
            "    Expand-7zipArchive -Path \"$dir\\`$PLUGINSDIR\\app-64.7z\" -DestinationPath $dir",
            "    Remove-Item \"$dir\\`$PLUGINSDIR\" -Force -Recurse -ErrorAction SilentlyContinue",
            "    Remove-Item \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "bin": "chat2db.exe",
    "shortcuts": [
        [
            "chat2db.exe",
            "Chat2DB"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chat2db/Chat2DB/releases/download/v$version/Chat2DB-Community-$version.msi"
            }
        }
    }
}
