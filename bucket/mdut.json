    "license": "AGPL-3.0-or-later",
    "notes": "https://github.com/ViCrack/scoop-bucket/blob/master/bucket/mdut.json",
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "url": "https://github.com/SafeGroceryStore/MDUT/releases/download/v3.3.2/v3.3.2_Multiple_Database_Utilization_Tools_windows_amd64.zip",
    "hash": "77a49babd113be112ec9203c43eff623392b7c1fa7f2cdc45948f7199f3aa63c",
    "pre_install": [
        "Set-Content \"$dir\\mdut.bat\" '@pushd %~dp0
@start javaw.exe -jar \"Multiple.Database.Utilization.Tools-$version-jar-with-dependencies.jar\" %*
@popd' -Encoding Ascii",
        "if (!(Test-Path \"$persist_dir\\vicr.yaml\")) { New-Item \"$dir\\vicr.yaml\" | Out-Null }"
    ],
    "bin": "mdut.bat",
    "shortcuts": [
        [
            "mdut.bat",
            "Mdut"
        ]
    ],
    "persist": [
        "data.db",
        "config.yaml"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/SafeGroceryStore/MDUT/releases/download/v$version/v$version_Multiple_Database_Utilization_Tools_windows_amd64.zip"
    }
}
