    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "url": "https://github.com/SafeGroceryStore/MDUT/releases/download/v3.3.0/v3.3.0_Multiple_Database_Utilization_Tools_windows_amd64.zip",
    "hash": "8c0e1a0dbe4628afc4e050de83968b2bee00d7646360d7bed3304239918fa9b1",
    "pre_install": [
        "Set-Content \"$dir\\mdut.bat\" '@pushd %~dp0
@start javaw.exe -jar \"Multiple.Database.Utilization.Tools-$version-jar-with-dependencies.jar\" %*
@popd' -Encoding Ascii",
        "if (!(Test-Path \"$persist_dir\\vicr.yaml\")) { New-Item \"$dir\\vicr.yaml\" | Out-Null }"
    ],
    "bin": "mdut.bat",
    "shortcuts": [
        [
            "mdut.bat",
            "Mdut"
        ]
    ],
    "persist": [
        "data.db",
        "config.yaml"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/SafeGroceryStore/MDUT/releases/download/v$version/v$version_Multiple_Database_Utilization_Tools_windows_amd64.zip"
    }
}
